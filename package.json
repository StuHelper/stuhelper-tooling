{
  "name": "@stuhelper/engineering-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "test": "node --test src/*.test.mjs src/docs/*.test.mjs src/i18n/*.test.mjs",
    "check": "node bin/stuhelper-check.mjs repository && pnpm test && node bin/stuhelper-check.mjs docs",
    "hooks": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "2.2.2"
  },
  "packageManager": "pnpm@10.33.4",
  "version": "0.1.3",
  "files": [
    "bin",
    "src",
    "presets"
  ],
  "bin": {
    "stuhelper-check": "bin/stuhelper-check.mjs"
  },
  "exports": {
    "./docs": "./src/docs/check-docs.mjs",
    "./i18n": "./src/i18n/check-i18n.mjs"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "markdownlint": "0.42.0",
    "picomatch": "4.0.7",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "katex": "0.18.2"
    }
  },
  "description": "Shared local checks and GitHub Actions for StuHelper repositories",
  "repository": "github:StuHelper/stuhelper-tooling",
  "license": "AGPL-3.0-only"
}
